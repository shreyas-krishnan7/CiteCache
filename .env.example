# Copy this file to .env and fill in as needed.
# Every value has a sane default in app/config.py, so phase 1+2 work
# with an empty .env — no API keys required (local embeddings only).

# --- Vector store ---
# "embedded" = local file storage, no server needed (default for dev).
# "server"   = connect to a running Qdrant server (Docker / cloud).
QDRANT_MODE=embedded
QDRANT_DATA_PATH=./qdrant_data
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_DOC_COLLECTION=citecache_docs
QDRANT_CACHE_COLLECTION=citecache_cache

# --- Embeddings ---
# "local" uses sentence-transformers (no key needed).
# "openai" uses the OpenAI embeddings API (requires OPENAI_API_KEY).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- LLM (used from phase 4 onward: generation + citation verification) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Cache policy (used from phase 5 onward) ---
CACHE_SIMILARITY_THRESHOLD=0.95
CACHE_WRITE_CONFIDENCE_THRESHOLD=0.75
CACHE_TTL_DAYS=7

# --- Chunking ---
CHUNK_SIZE_TOKENS=300
CHUNK_OVERLAP_TOKENS=50

# --- Hybrid Retrieval ---
RRF_K=60
HYBRID_TOP_K=20
FINAL_TOP_K=5
